# --- Database ---
# postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://stadium_user:stadium_pass@localhost:5432/stadium_db

# --- Auth ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Paystack ---
# From your Paystack dashboard -> Settings -> API Keys & Webhooks
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- CORS ---
# Comma-separated list of origins allowed to call this API
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend URL used as Paystack's payment return URL
FRONTEND_URL=http://localhost:5173

# --- Auth cookie ---
# The access token is set as an httpOnly cookie rather than returned in
# the JSON response body, so it can't be read by JS (including injected
# XSS) the way a localStorage token can.
#
# COOKIE_SECURE must be true in production - browsers refuse to send a
# Secure cookie back over plain http. Leave it false for local dev.
#
# COOKIE_SAMESITE="lax" is correct for same-site setups, which includes
# a frontend and backend that share a registrable domain (e.g.
# app.example.com + api.example.com, or localhost on two different
# ports - port doesn't count for "site" purposes). Only set this to
# "none" (and COOKIE_SECURE=true) if the frontend and backend are on
# genuinely different domains.
#
# COOKIE_DOMAIN is usually best left unset (defaults to the exact host
# that issued the cookie). Only set it if you need the cookie shared
# across subdomains, e.g. ".example.com".
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.example.com
